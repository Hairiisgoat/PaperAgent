# 应用数据库配置从后端 .env 读取；同名系统环境变量优先。
# 将其复制为 .env 后在本机填写。禁止提交真实密钥和密码。
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=paper_agent
MYSQL_USER=
MYSQL_PASSWORD=
# 相对路径以启动后端服务的工作目录为基准；此文件只用于 LangGraph 检查点。
LANGGRAPH_SQLITE_PATH=./data/langgraph-checkpoints.sqlite3
# GLM：在本机 .env 填入新密钥和可用模型名；未配置不会影响其他功能。
LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
LLM_MODEL=
LLM_API_KEY=
LLM_TIMEOUT_SECONDS=30
LLM_PLANNER_READ_TIMEOUT_SECONDS=120
